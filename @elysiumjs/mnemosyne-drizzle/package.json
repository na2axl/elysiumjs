{
	"name": "@elysiumjs/mnemosyne-drizzle",
	"version": "0.1.4",
	"license": "Apache-2.0",
	"description": "Drizzle ORM driver for @elysiumjs/mnemosyne",
	"private": false,
	"author": "Workbud Technologies Inc.",
	"repository": {
		"type": "git",
		"url": "https://github.com/workbud/elysium"
	},
	"homepage": "https://github.com/workbud/elysium",
	"scripts": {
		"format": "prettier --write \"./src/**/*.ts\"",
		"clean": "rimraf dist",
		"build": "bun run clean && tsc && bun run build:minify",
		"build:minify": "bun scripts/minify.ts",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "bun run build"
	},
	"keywords": [
		"elysium",
		"database",
		"orm",
		"drizzle",
		"postgresql"
	],
	"module": "dist/index.js",
	"type": "module",
	"types": "dist/index.d.ts",
	"sideEffects": false,
	"peerDependencies": {
		"@elysiumjs/core": "workspace:^",
		"@elysiumjs/mnemosyne": "workspace:^"
	},
	"dependencies": {
		"drizzle-orm": "^0.45.1",
		"prompts": "^2.4.2",
		"radash": "catalog:"
	},
	"devDependencies": {
		"@types/prompts": "^2.4.9",
		"@elysiumjs/core": "workspace:*",
		"@elysiumjs/mnemosyne": "workspace:*"
	}
}
