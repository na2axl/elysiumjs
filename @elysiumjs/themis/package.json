{
  "name": "@elysiumjs/themis",
  "version": "0.3.5",
  "license": "Apache-2.0",
  "description": "Authentication for the Elysium.js framework: passwords, tokens, sessions, guards, CSRF, TOTP, OAuth and passkeys.",
  "private": false,
  "author": {
    "name": "Axel Nana",
    "email": "axel.nana@workbud.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/na2axl/elysiumjs.git",
    "directory": "@elysiumjs/themis"
  },
  "homepage": "https://github.com/na2axl/elysiumjs/tree/main/@elysiumjs/themis#readme",
  "bugs": {
    "url": "https://github.com/na2axl/elysiumjs/issues"
  },
  "scripts": {
    "format": "prettier --write \"./src/**/*.ts\"",
    "clean": "rimraf dist",
    "build:js": "bun build ./src/index.ts ./src/scrypt.ts --outdir ./dist --target browser --packages external --splitting --root ./src --minify-syntax --minify-whitespace",
    "build:ts": "tsc",
    "build": "bun run clean && bun run build:js && bun run build:ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "test:coverage": "bun test --coverage"
  },
  "keywords": [
    "elysium",
    "framework",
    "typescript",
    "auth",
    "sessions",
    "jwt",
    "passkeys"
  ],
  "type": "module",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./scrypt": {
      "types": "./dist/scrypt.d.ts",
      "import": "./dist/scrypt.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "dependencies": {
    "@simplewebauthn/server": "^14.0.3",
    "jose": "^6.2.15",
    "oauth4webapi": "^3.8.8"
  },
  "devDependencies": {
    "@elysiumjs/core": "workspace:*",
    "@elysiumjs/runtime-bun": "workspace:*",
    "elysia": "^2.0.0-rc.1"
  },
  "peerDependencies": {
    "@elysiumjs/core": "workspace:^"
  }
}
