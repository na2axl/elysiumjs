{
  "name": "@elysiumjs/ariadne-workers",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "A Cloudflare Durable Object flow store for @elysiumjs/ariadne.",
  "private": false,
  "author": {
    "name": "Axel Nana",
    "email": "axel.nana@workbud.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/na2axl/elysiumjs.git",
    "directory": "@elysiumjs/ariadne-workers"
  },
  "homepage": "https://github.com/na2axl/elysiumjs/tree/main/@elysiumjs/ariadne-workers#readme",
  "bugs": {
    "url": "https://github.com/na2axl/elysiumjs/issues"
  },
  "scripts": {
    "format": "prettier --write \"./src/**/*.ts\"",
    "clean": "rimraf dist",
    "build:js": "bun build ./src/index.ts --outdir ./dist --target browser --packages external -e 'cloudflare:workers' --root ./src --minify-syntax --minify-whitespace",
    "build:ts": "tsc",
    "build": "bun run clean && bun run build:js && bun run build:ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "test:coverage": "bun test --coverage"
  },
  "keywords": [
    "elysium",
    "framework",
    "typescript",
    "flows",
    "cloudflare",
    "workers",
    "durable-objects"
  ],
  "type": "module",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "devDependencies": {
    "@elysiumjs/ariadne": "workspace:*",
    "@elysiumjs/core": "workspace:*",
    "elysia": "^2.0.0-rc.1"
  },
  "peerDependencies": {
    "@elysiumjs/ariadne": "workspace:^"
  }
}
