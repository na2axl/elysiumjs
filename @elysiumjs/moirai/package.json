{
  "name": "@elysiumjs/moirai",
  "version": "0.2.0",
  "license": "Apache-2.0",
  "description": "Actions, queries, idempotency, outbox, inbox and domain events for the Elysium.js framework.",
  "private": false,
  "author": {
    "name": "Axel Nana",
    "email": "axel.nana@workbud.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/na2axl/elysiumjs.git",
    "directory": "@elysiumjs/moirai"
  },
  "homepage": "https://github.com/na2axl/elysiumjs/tree/main/@elysiumjs/moirai#readme",
  "bugs": {
    "url": "https://github.com/na2axl/elysiumjs/issues"
  },
  "scripts": {
    "format": "prettier --write \"./src/**/*.ts\"",
    "clean": "rimraf dist",
    "build:js": "bun build ./src/index.ts ./src/heracles.ts --outdir ./dist --target browser --packages external --splitting --root ./src --minify-syntax --minify-whitespace",
    "build:ts": "tsc",
    "build": "bun run clean && bun run build:js && bun run build:ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "test:coverage": "bun test --coverage"
  },
  "keywords": [
    "elysium",
    "framework",
    "typescript",
    "cqrs",
    "commands",
    "idempotency",
    "outbox"
  ],
  "type": "module",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./heracles": {
      "types": "./dist/heracles.d.ts",
      "import": "./dist/heracles.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "./dist/heracles.js",
    "./src/heracles.ts"
  ],
  "dependencies": {
    "typebox": "^1.3.0"
  },
  "devDependencies": {
    "@elysiumjs/core": "workspace:*",
    "@elysiumjs/heracles": "workspace:*",
    "@elysiumjs/mnemosyne": "workspace:*",
    "@elysiumjs/redis": "workspace:*",
    "elysia": "^2.0.0-rc.1"
  },
  "peerDependencies": {
    "@elysiumjs/core": "workspace:^",
    "@elysiumjs/heracles": "workspace:^",
    "@elysiumjs/mnemosyne": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@elysiumjs/heracles": {
      "optional": true
    }
  }
}
