{
  "name": "@elysiumjs/cerberus",
  "version": "0.3.2",
  "license": "Apache-2.0",
  "description": "Ability-based roles and permissions layer for Elysium.js apps.",
  "private": false,
  "author": "Workbud Technologies Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/na2axl/elysiumjs.git",
    "directory": "@elysiumjs/cerberus"
  },
  "homepage": "https://github.com/na2axl/elysiumjs/tree/main/@elysiumjs/cerberus#readme",
  "bugs": {
    "url": "https://github.com/na2axl/elysiumjs/issues"
  },
  "scripts": {
    "format": "prettier --write \"./src/**/*.ts\"",
    "clean": "rimraf dist",
    "build:js": "bun build ./src/index.ts --outdir ./dist --target bun --packages external --root ./src --minify-syntax --minify-whitespace",
    "build:ts": "tsc",
    "build": "bun run clean && bun run build:js && bun run build:ts",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "elysium",
    "framework",
    "web",
    "api",
    "typescript",
    "authorization",
    "role-based",
    "permissions"
  ],
  "module": "dist/index.js",
  "type": "module",
  "sideEffects": false,
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "@casl/ability": "^7.0.2"
  },
  "devDependencies": {
    "@elysiumjs/core": "workspace:*"
  },
  "peerDependencies": {
    "@elysiumjs/core": "workspace:^"
  }
}
