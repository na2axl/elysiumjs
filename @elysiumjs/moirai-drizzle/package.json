{
	"name": "@elysiumjs/moirai-drizzle",
	"version": "0.1.2",
	"license": "Apache-2.0",
	"description": "Postgres stores for @elysiumjs/moirai through Drizzle ORM: idempotency keys, outbox, inbox and advisory locks.",
	"private": false,
	"author": {
		"name": "Axel Nana",
		"email": "axel.nana@workbud.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/na2axl/elysiumjs.git",
		"directory": "@elysiumjs/moirai-drizzle"
	},
	"homepage": "https://github.com/na2axl/elysiumjs/tree/main/@elysiumjs/moirai-drizzle#readme",
	"bugs": {
		"url": "https://github.com/na2axl/elysiumjs/issues"
	},
	"scripts": {
		"format": "prettier --write \"./src/**/*.ts\"",
		"clean": "rimraf dist",
		"build:js": "bun build ./src/index.ts --outdir ./dist --target node --packages external --root ./src --minify-syntax --minify-whitespace",
		"build:ts": "tsc",
		"build": "bun run clean && bun run build:js && bun run build:ts",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "bun run build",
		"test": "bun test",
		"test:coverage": "bun test --coverage"
	},
	"keywords": [
		"elysium",
		"framework",
		"typescript",
		"commands",
		"outbox",
		"drizzle",
		"postgresql"
	],
	"type": "module",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"CHANGELOG.md"
	],
	"sideEffects": false,
	"dependencies": {
		"drizzle-orm": "^1.0.0-rc.5"
	},
	"devDependencies": {
		"@elysiumjs/core": "workspace:*",
		"@elysiumjs/mnemosyne-drizzle": "workspace:*",
		"@elysiumjs/moirai": "workspace:*",
		"@elysiumjs/runtime-bun": "workspace:*"
	},
	"peerDependencies": {
		"@elysiumjs/core": "workspace:^",
		"@elysiumjs/mnemosyne-drizzle": "workspace:^",
		"@elysiumjs/moirai": "workspace:^"
	}
}
