{
  "name": "@elysiumjs/hermes",
  "version": "0.4.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/na2axl/elysiumjs.git",
    "directory": "@elysiumjs/hermes"
  },
  "homepage": "https://github.com/na2axl/elysiumjs/tree/main/@elysiumjs/hermes#readme",
  "bugs": {
    "url": "https://github.com/na2axl/elysiumjs/issues"
  },
  "type": "module",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "format": "prettier --write \"./src/**/*.ts\"",
    "clean": "rimraf dist",
    "build:js": "bun build ./src/index.ts --outdir ./dist --target bun --packages external --root ./src --minify-syntax --minify-whitespace",
    "build:ts": "tsc",
    "build": "bun run clean && bun run build:js && bun run build:ts",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0"
  },
  "devDependencies": {
    "@elysiumjs/core": "workspace:*"
  },
  "peerDependencies": {
    "@elysiumjs/core": "workspace:^"
  }
}
