{
	"name": "@elysiumjs/mnemosyne",
	"version": "0.3.1",
	"license": "Apache-2.0",
	"description": "Database and caching for Elysium.js applications",
	"private": false,
	"author": "Workbud Technologies Inc.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/na2axl/elysiumjs.git",
		"directory": "@elysiumjs/mnemosyne"
	},
	"homepage": "https://github.com/na2axl/elysiumjs/tree/main/@elysiumjs/mnemosyne#readme",
	"bugs": {
		"url": "https://github.com/na2axl/elysiumjs/issues"
	},
	"scripts": {
		"format": "prettier --write \"./src/**/*.ts\"",
		"clean": "rimraf dist",
		"build:js": "bun build ./src/index.ts --outdir ./dist --target bun --packages external --root ./src --minify-syntax --minify-whitespace",
		"build:ts": "tsc",
		"build": "bun run clean && bun run build:js && bun run build:ts",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "bun run build",
		"test": "bun test",
		"test:coverage": "bun test --coverage"
	},
	"keywords": [
		"elysium",
		"database",
		"cache",
		"orm"
	],
	"module": "dist/index.js",
	"type": "module",
	"types": "dist/index.d.ts",
	"files": [
		"dist",
		"CHANGELOG.md"
	],
	"sideEffects": false,
	"peerDependencies": {
		"@elysiumjs/core": "workspace:^"
	},
	"devDependencies": {
		"@elysiumjs/core": "workspace:*"
	},
	"dependencies": {
		"cache-manager": "^7.2.9",
		"cacheable": "^2.5.0",
		"keyv": "^5.6.0",
		"radash": "catalog:"
	}
}
