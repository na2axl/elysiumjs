{
  "name": "@elysiumjs/hephaestus",
  "version": "0.3.0",
  "license": "Apache-2.0",
  "description": "Compilation and bundling utilities for Elysium.js apps.",
  "private": false,
  "author": "Workbud Technologies Inc.",
  "repository": {
    "type": "git",
    "url": "https://github.com/workbud/elysium"
  },
  "keywords": [
    "elysium",
    "framework",
    "web",
    "api",
    "typescript",
    "builder",
    "compilation",
    "bun"
  ],
  "homepage": "https://github.com/workbud/elysium",
  "module": "index.ts",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "format": "prettier --write \"./src/**/*.ts\"",
    "clean": "rimraf dist",
    "build:js": "bun build ./src/index.ts --outdir ./dist --target bun -e zod -e @elysiumjs/core --root ./src --minify-syntax --minify-whitespace",
    "build:ts": "tsc",
    "build": "bun run clean && bun run build:js && bun run build:ts",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@elysiumjs/core": "workspace:*"
  },
  "peerDependencies": {
    "@elysiumjs/core": "workspace:^"
  }
}
