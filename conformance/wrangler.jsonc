// The Worker the workerd conformance lane runs its tests in (see vitest.workerd.config.ts).
{
	"name": "elysium-conformance",
	"main": "tests/workerd/worker.ts",
	"compatibility_date": "2025-09-01",
	"compatibility_flags": ["nodejs_compat"],
	"kv_namespaces": [{ "binding": "CACHE", "id": "elysium-conformance-cache" }],
	// The `jobs` consumer is declared for parity with a deployed Worker: the queue tests call
	// `worker.queue()` directly with a batch from `createMessageBatch()`.
	"queues": {
		"producers": [{ "binding": "JOBS", "queue": "jobs" }],
		"consumers": [{ "queue": "jobs", "max_batch_size": 10, "max_batch_timeout": 1 }]
	},
	"services": [{ "binding": "SELF", "service": "elysium-conformance" }],
	// The flow store of @elysiumjs/ariadne-workers, exported by the Worker.
	"durable_objects": { "bindings": [{ "name": "FLOWS", "class_name": "FlowStoreObject" }] },
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["FlowStoreObject"] }]
}
