// The Worker the wrangler gate runs: check-wrangler.ts builds dist/worker.js next to this file.
{
	"name": "elysium-workers-check",
	"main": "dist/worker.js",
	"no_bundle": true,
	"compatibility_date": "2025-09-01",
	"compatibility_flags": ["nodejs_compat"],
	"kv_namespaces": [{ "binding": "CACHE", "id": "elysium-check-cache" }],
	"queues": {
		"producers": [{ "binding": "JOBS", "queue": "elysium-jobs" }],
		"consumers": [{ "queue": "elysium-jobs", "max_batch_size": 10, "max_batch_timeout": 1 }]
	},
	"triggers": { "crons": ["*/5 * * * *"] }
}
