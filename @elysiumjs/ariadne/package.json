{
  "name": "@elysiumjs/ariadne",
  "version": "0.2.3",
  "license": "Apache-2.0",
  "description": "Multi-step flows for the Elysium.js framework, with replayable steps and server-side state.",
  "private": false,
  "author": {
    "name": "Axel Nana",
    "email": "axel.nana@workbud.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/na2axl/elysiumjs.git",
    "directory": "@elysiumjs/ariadne"
  },
  "homepage": "https://github.com/na2axl/elysiumjs/tree/main/@elysiumjs/ariadne#readme",
  "bugs": {
    "url": "https://github.com/na2axl/elysiumjs/issues"
  },
  "scripts": {
    "format": "prettier --write \"./src/**/*.ts\"",
    "clean": "rimraf dist",
    "build:js": "bun build ./src/index.ts --outdir ./dist --target browser --packages external --root ./src --minify-syntax --minify-whitespace",
    "build:ts": "tsc",
    "build": "bun run clean && bun run build:js && bun run build:ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "test:coverage": "bun test --coverage"
  },
  "keywords": [
    "elysium",
    "framework",
    "typescript",
    "flows",
    "wizard",
    "multi-step"
  ],
  "type": "module",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "dependencies": {
    "typebox": "^1.3.0"
  },
  "devDependencies": {
    "@elysiumjs/core": "workspace:*",
    "@elysiumjs/runtime-bun": "workspace:*",
    "elysia": "^2.0.0-rc.1",
    "@elysiumjs/themis": "workspace:*"
  },
  "peerDependencies": {
    "@elysiumjs/core": "workspace:^"
  }
}
