import type { WS, WSError } from '@elysiumjs/olympus';

import { Websocket } from '@elysiumjs/olympus';

@Websocket.controller('{path}')
export class {name} {
	@Websocket.onOpen()
	private onOpen() {
		console.log('websocket opened');
	}

	@Websocket.onClose()
	private onClose() {
		console.log('websocket closed');
	}

	@Websocket.onMessage()
	private onMessage(ws: WS, data: any) {
		ws.send(data);
	}

	@Websocket.onError()
	private onErrorWS(e: WSError) {
		console.error(e.error.message);
	}
}
