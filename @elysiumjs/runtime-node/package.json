{
  "name": "@elysiumjs/runtime-node",
  "version": "0.1.1",
  "license": "Apache-2.0",
  "description": "Node.js runtime for the Elysium.js framework.",
  "private": false,
  "author": {
    "name": "Axel Nana",
    "email": "axel.nana@workbud.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/na2axl/elysiumjs.git",
    "directory": "@elysiumjs/runtime-node"
  },
  "homepage": "https://github.com/na2axl/elysiumjs/tree/main/@elysiumjs/runtime-node#readme",
  "bugs": {
    "url": "https://github.com/na2axl/elysiumjs/issues"
  },
  "scripts": {
    "format": "prettier --write \"./src/**/*.ts\"",
    "clean": "rimraf dist",
    "build:js": "bun build ./src/index.ts --outdir ./dist --target node --packages external --root ./src --minify-syntax --minify-whitespace",
    "build:ts": "tsc",
    "build": "bun run clean && bun run build:js && bun run build:ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "test:coverage": "bun test --coverage"
  },
  "keywords": [
    "elysium",
    "framework",
    "typescript",
    "runtime",
    "node"
  ],
  "type": "module",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "devDependencies": {
    "@elysiumjs/core": "workspace:*",
    "elysia": "^2.0.0-rc.1"
  },
  "peerDependencies": {
    "@elysiumjs/core": "workspace:^"
  }
}
