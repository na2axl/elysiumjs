{
  "name": "@elysiumjs/core",
  "version": "0.22.0",
  "license": "Apache-2.0",
  "description": "A structured web framework built on ElysiaJS, for Bun, Node.js and Cloudflare Workers.",
  "private": false,
  "author": "Workbud Technologies Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/na2axl/elysiumjs.git",
    "directory": "@elysiumjs/core"
  },
  "homepage": "https://github.com/na2axl/elysiumjs/tree/main/@elysiumjs/core#readme",
  "bugs": {
    "url": "https://github.com/na2axl/elysiumjs/issues"
  },
  "scripts": {
    "format": "prettier --write \"./src/**/*.ts\"",
    "clean": "rimraf dist",
    "build:js": "bun build ./src/index.ts --outdir ./dist --target node --packages external --root ./src --minify-syntax --minify-whitespace",
    "build:ts": "tsc",
    "build": "bun run clean && bun run build:js && bun run build:ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.types.json",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "check:runtime": "bun scripts/check-runtime.ts",
    "check:minified": "bun scripts/check-minified.ts"
  },
  "keywords": [
    "elysium",
    "framework",
    "web",
    "api",
    "typescript"
  ],
  "module": "dist/index.js",
  "type": "module",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "./src/index.ts"
  ],
  "dependencies": {
    "@elysia/openapi": "^2.0.0-rc.0",
    "elysia": "^2.0.0-rc.1",
    "exact-mirror": "^1.2.6",
    "http-status": "^2.1.0",
    "openapi-types": "^12.1.3",
    "radash": "catalog:",
    "typebox": "^1.3.0",
    "wampy": "^8.0.2"
  },
  "trustedDependencies": [
    "es5-ext"
  ]
}
