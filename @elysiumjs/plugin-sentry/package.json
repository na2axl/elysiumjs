{
  "name": "@elysiumjs/plugin-sentry",
  "version": "0.2.1",
  "license": "Apache-2.0",
  "description": "Sentry error reporting plugin for the Elysium.js framework.",
  "private": false,
  "author": {
    "name": "Axel Nana",
    "email": "axel.nana@workbud.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/na2axl/elysiumjs.git",
    "directory": "@elysiumjs/plugin-sentry"
  },
  "homepage": "https://github.com/na2axl/elysiumjs/tree/main/@elysiumjs/plugin-sentry#readme",
  "bugs": {
    "url": "https://github.com/na2axl/elysiumjs/issues"
  },
  "scripts": {
    "format": "prettier --write \"./src/**/*.ts\"",
    "clean": "rimraf dist",
    "build:js": "bun build ./src/index.ts --outdir ./dist --target bun --packages external --root ./src --minify-syntax --minify-whitespace",
    "build:ts": "tsc",
    "build": "bun run clean && bun run build:js && bun run build:ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "test:coverage": "bun test --coverage"
  },
  "keywords": [
    "elysium",
    "framework",
    "web",
    "api",
    "typescript",
    "sentry",
    "error",
    "reporting"
  ],
  "type": "module",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "devDependencies": {
    "@elysiumjs/core": "workspace:*"
  },
  "peerDependencies": {
    "@elysiumjs/core": "workspace:^"
  },
  "dependencies": {
    "@elysiajs/opentelemetry": "^1.4.11",
    "@sentry/bun": "^11.9.0"
  }
}
