{
  "name": "create-elysium",
  "version": "0.2.2",
  "license": "Apache-2.0",
  "description": "Bootstrap you next Elysium.js app!",
  "author": {
    "name": "Axel Nana",
    "email": "axel.nana@workbud.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/na2axl/elysiumjs.git",
    "directory": "create-elysium"
  },
  "homepage": "https://github.com/na2axl/elysiumjs/tree/main/create-elysium#readme",
  "bugs": {
    "url": "https://github.com/na2axl/elysiumjs/issues"
  },
  "scripts": {
    "format": "prettier --write \"./**/*.ts\"",
    "build": "bun build index.ts --outfile=index.js --target bun --minify"
  },
  "keywords": [
    "elysium",
    "framework",
    "web",
    "api",
    "typescript"
  ],
  "bin": {
    "create-elysium": "./index.js"
  },
  "files": [
    "index.js",
    "template-*/**",
    "feature-*/**",
    "shared-*/**",
    "plugin-*/**"
  ],
  "type": "module",
  "devDependencies": {
    "@types/prompts": "^2.4.9"
  },
  "dependencies": {
    "@elysiumjs/core": "workspace:*",
    "prompts": "^2.4.2",
    "radash": "catalog:"
  }
}
