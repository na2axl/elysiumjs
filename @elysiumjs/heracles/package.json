{
  "name": "@elysiumjs/heracles",
  "version": "0.7.0",
  "description": "Background job processing system for Elysium.js apps.",
  "module": "dist/index.js",
  "type": "module",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "test": "bun test",
    "dev": "bun --watch src/index.ts",
    "format": "prettier --write 'src/**/*.{ts,tsx}'",
    "clean": "rimraf dist",
    "build:js": "bun build ./src/index.ts --outdir ./dist --target bun --packages external --root ./src --minify-syntax --minify-whitespace",
    "build:ts": "tsc",
    "build": "bun run clean && bun run build:js && bun run build:ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build",
    "example:optimized": "bun run examples/optimized_example.ts",
    "example:worker": "bun run examples/redis_worker_example.ts",
    "example:comprehensive": "bun run examples/heracles_comprehensive.ts"
  },
  "keywords": [
    "elysium",
    "job",
    "queue",
    "worker",
    "scheduler",
    "background",
    "processing",
    "heracles"
  ],
  "author": "Workbud Technologies Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/na2axl/elysiumjs.git",
    "directory": "@elysiumjs/heracles"
  },
  "homepage": "https://github.com/na2axl/elysiumjs/tree/main/@elysiumjs/heracles#readme",
  "bugs": {
    "url": "https://github.com/na2axl/elysiumjs/issues"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "commander": "^15.0.0",
    "radash": "catalog:"
  },
  "devDependencies": {
    "@elysiumjs/core": "workspace:*"
  },
  "peerDependencies": {
    "@elysiumjs/core": "workspace:^"
  }
}
